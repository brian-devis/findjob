# AIJob 后端环境变量模板（复制为 .env 使用，勿提交 .env）
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./data/aijob.db

# JWT 签名密钥：必须配置为至少 32 字符的随机强密钥，示例生成：openssl rand -hex 32
JWT_SECRET=
# AI Provider API Key 加密主密钥（可选；留空时通过 HKDF 从 JWT_SECRET 域隔离派生）
PROVIDER_MASTER_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

LOG_LEVEL=INFO
# 前端构建产物目录（Docker 镜像内默认为 /app/static；本地留空自动探测 ../frontend/dist）
STATIC_DIR=

# WebSocket 与任务调度参数
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_HEARTBEAT_TIMEOUT_SECONDS=10
WS_HEARTBEAT_MAX_MISSED=3
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SECONDS=2
TASK_DISPATCH_LEASE_SECONDS=30

# 首次启动引导管理员（可选；已存在则忽略）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
