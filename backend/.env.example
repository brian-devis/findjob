# AIJob 后端环境变量模板（复制为 .env 使用，勿提交 .env）
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./data/aijob.db

# JWT 签名密钥：必须配置为至少 32 字符的随机强密钥，示例生成：openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

LOG_LEVEL=INFO

# 首次启动引导管理员（可选；已存在则忽略）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
