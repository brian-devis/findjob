# AIJob Local Agent 配置示例（复制为 .env 并填入注册 Agent 后获得的一次性凭据）
AIJOB_SERVER_WS_URL=wss://fj.asgo.click:8443/ws/agent
AIJOB_AGENT_ID=00000000-0000-0000-0000-000000000000
AIJOB_AGENT_SECRET=replace-with-agent-secret
AIJOB_STATE_DB_PATH=./data/agent_state.db
AIJOB_HEARTBEAT_INTERVAL_SECONDS=20
AIJOB_RECV_TIMEOUT_SECONDS=45
AIJOB_LOG_LEVEL=INFO

# 本地持久化浏览器配置（Windows 下可设为 %LOCALAPPDATA%\AIJob\browser-profile）
AIJOB_BROWSER_CHANNEL=chrome
AIJOB_BROWSER_PROFILE_DIR=./data/browser-profile
AIJOB_BOSS_BASE_URL=https://www.zhipin.com
AIJOB_BOSS_RESUME_URL=https://www.zhipin.com/web/geek/resume
AIJOB_BOSS_JOBS_URL=https://www.zhipin.com/web/geek/job
AIJOB_BROWSER_HEADLESS=false
